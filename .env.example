# PowerShell scripts/start.ps1 reads process environment variables, not this file automatically.
# With no DB_URL, start.ps1 starts an isolated MySQL instance on 127.0.0.1:3307.
# To use your own MySQL, set these environment variables before starting:
DB_URL=jdbc:mysql://127.0.0.1:3306/tijian?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=health_app
DB_PASSWORD=replace_me
SERVER_PORT=8080
VITE_API_TARGET=http://127.0.0.1:8080
SEED_ENABLED=true
